# spring.data.mongodb.database=antecedent_db
spring.data.mongodb.uri=<CONNECTION_STRING>/antecedent_db?useBigInt64=true&retryWrites=true&w=majority


converter.app.bufferSize=1024

spring.servlet.multipart.max_file_size=256MB
spring.servlet.multipart.max_request_size=256MB
spring.servlet.multipart.enabled=true

server.port=8090

CONVERTORS.app.wordprocessor=http://awawp:8000/
CONVERTORS.app.microservice = http://antecedent:8080/micro/

schedule.ConvDelay=250
schedule.CompDelay=250
schedule.gradeDelay=1000

